{
  "name": "@auction/shared",
  "version": "1.0.0",
  "description": "Shared types and constants for auction system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist/**/*"
  ],
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
